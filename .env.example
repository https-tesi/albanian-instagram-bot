PORT=3000
INSTAGRAM_VERIFY_TOKEN=change_me
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
META_API_VERSION=
DATABASE_URL=
HUMAN_REQUIRED_TIMEOUT_HOURS=24
HUMAN_ACTIVE_TIMEOUT_HOURS=24
OPENAI_API_KEY=
# Optional tuning (defaults shown)
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=250
MAX_AI_MESSAGES_PER_USER_PER_DAY=30
MAX_CONVERSATION_HISTORY_MESSAGES=6
# 0 disables the optional monthly guard until pricing is configured.
MONTHLY_AI_BUDGET_USD=0
OPENAI_INPUT_PRICE_PER_MILLION=0
OPENAI_OUTPUT_PRICE_PER_MILLION=0
# Official Meta WhatsApp Cloud API handoff notification (disabled by default).
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# International format, digits only, without + (for example 3556XXXXXXXX).
WHATSAPP_RECIPIENT_PHONE=
# Optional: falls back to META_API_VERSION.
WHATSAPP_API_VERSION=
